<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitDash.Presentation.ViewModels"
             xmlns:conv="using:GitDash.App.Converters"
             x:Class="GitDash.App.Views.TimersView"
             x:DataType="vm:TimersViewModel">
  <ScrollViewer>
    <StackPanel Margin="36,30,36,36" Spacing="24">

      <Grid ColumnDefinitions="*,Auto" Classes="enter">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Timers" />
          <TextBlock Classes="muted" Text="Track a task, run Pomodoro sessions, or time a pull request review." />
        </StackPanel>
        <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
          <TextBlock>
            <Run Text="Tracked today:" />
            <Run Text="{Binding TodayTotal}" FontWeight="Bold" />
          </TextBlock>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,20,*,20,*">

        <!-- Task timer -->
        <Panel Grid.Column="0" Classes="enter1">
          <Border Classes="card lift" MinHeight="430">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="h2" Text="Task timer" />
                <Ellipse Classes="pulse" Width="8" Height="8" Fill="{StaticResource GreenBrush}"
                         VerticalAlignment="Center" IsVisible="{Binding IsTaskRunning}" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="primary" Content="Start" Command="{Binding ToggleTaskCommand}"
                        IsVisible="{Binding !IsTaskRunning}" />
                <Button Classes="primary" Content="Pause" Command="{Binding ToggleTaskCommand}"
                        IsVisible="{Binding IsTaskRunning}" />
                <Button Classes="ghost" Content="Finish &amp; save" Command="{Binding FinishTaskCommand}" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center" Spacing="22">
                <TextBox Text="{Binding TaskName}" Watermark="What are you working on?" MaxLength="120" />
                <TextBlock Classes="clock" Text="{Binding TaskElapsed}" />
              </StackPanel>
            </DockPanel>
          </Border>
        </Panel>

        <!-- Pomodoro -->
        <Panel Grid.Column="2" Classes="enter2">
          <Border Classes="card lift" MinHeight="430">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="h2" Text="Pomodoro" />
                <Ellipse Classes="pulse" Width="8" Height="8" Fill="{StaticResource PinkBrush}"
                         VerticalAlignment="Center" IsVisible="{Binding IsPomodoroRunning}" />
              </StackPanel>

              <Expander DockPanel.Dock="Bottom" Header="Durations" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
                  <StackPanel Margin="0,0,6,8" Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="Focus (min)" />
                    <NumericUpDown Value="{Binding FocusMinutes}" Minimum="1" Maximum="180" Increment="5"
                                   FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,8" Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="Short break (min)" />
                    <NumericUpDown Value="{Binding ShortBreakMinutes}" Minimum="1" Maximum="60" Increment="1"
                                   FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,0,6,0" Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="Long break (min)" />
                    <NumericUpDown Value="{Binding LongBreakMinutes}" Minimum="1" Maximum="120" Increment="5"
                                   FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="Rounds before long break" />
                    <NumericUpDown Value="{Binding Cycles}" Minimum="1" Maximum="12" Increment="1"
                                   FormatString="0" />
                  </StackPanel>
                </Grid>
              </Expander>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="primary" Content="Start" Command="{Binding TogglePomodoroCommand}"
                        IsVisible="{Binding !IsPomodoroRunning}" />
                <Button Classes="primary" Content="Pause" Command="{Binding TogglePomodoroCommand}"
                        IsVisible="{Binding IsPomodoroRunning}" />
                <Button Classes="ghost" Content="Skip" Command="{Binding SkipPomodoroCommand}" />
                <Button Classes="ghost" Content="Reset" Command="{Binding ResetPomodoroCommand}" />
              </StackPanel>

              <Panel Width="196" Height="196" Margin="0,14">
                <Ellipse Stroke="{DynamicResource Surface2Brush}" StrokeThickness="12" />
                <Arc Stroke="{StaticResource AccentGradient}" StrokeThickness="12" StrokeLineCap="Round"
                     StartAngle="-90" SweepAngle="{Binding PomodoroSweep}" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="label" Text="{Binding PomodoroPhase}" HorizontalAlignment="Center"
                             Foreground="{StaticResource PinkBrush}" />
                  <TextBlock Classes="clock" FontSize="38" Text="{Binding PomodoroRemaining}" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding PomodoroRound}" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
            </DockPanel>
          </Border>
        </Panel>

        <!-- Pull request review timer -->
        <Panel Grid.Column="4" Classes="enter3">
          <Border Classes="card lift" MinHeight="430">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="h2" Text="PR review timer" />
                <Ellipse Classes="pulse" Width="8" Height="8" Fill="{StaticResource AmberBrush}"
                         VerticalAlignment="Center" IsVisible="{Binding IsReviewRunning}" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="primary" Content="Start" Command="{Binding ToggleReviewCommand}"
                        IsVisible="{Binding !IsReviewRunning}" />
                <Button Classes="primary" Content="Pause" Command="{Binding ToggleReviewCommand}"
                        IsVisible="{Binding IsReviewRunning}" />
                <Button Classes="ghost" Content="Finish &amp; save" Command="{Binding FinishReviewCommand}" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center" Spacing="18">
                <ComboBox ItemsSource="{Binding ReviewTargets}" SelectedItem="{Binding SelectedReviewTarget}"
                          HorizontalAlignment="Stretch" PlaceholderText="Pick a pull request on your desk">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewTargetViewModel">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="clock" Text="{Binding ReviewElapsed}" />
                <TextBlock Classes="muted" HorizontalAlignment="Center">
                  <Run Text="Total on this pull request:" />
                  <Run Text="{Binding ReviewTotal}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </Border>
        </Panel>
      </Grid>

      <!-- Asked before a review timer starts on a pull request that is already approved -->
      <Border Classes="card" IsVisible="{Binding IsConfirmingApproved}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="h2" Text="Already approved" />
            <TextBlock Classes="muted" Text="{Binding ConfirmMessage}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelApprovedStartCommand}" />
            <Button Classes="primary" Content="Start anyway" Command="{Binding ConfirmApprovedStartCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Any number of timers of the same kind -->
      <Border Classes="card enter3">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="More timers" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Run as many task timers and countdowns as you like at once. Review timers for other pull requests show up here too." />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding NewTimerName}" Watermark="Name (optional)" MaxLength="120" />
            <Button Grid.Column="1" Classes="ghost" Content="Add task timer" Command="{Binding AddTaskTimerCommand}" />
            <NumericUpDown Grid.Column="2" Width="120" Value="{Binding CountdownMinutes}" Minimum="1" Maximum="1440"
                           Increment="5" FormatString="0" />
            <TextBlock Grid.Column="3" Classes="muted" Text="min" VerticalAlignment="Center" />
            <Button Grid.Column="4" Classes="primary" Content="Start countdown" Command="{Binding AddCountdownCommand}" />
          </Grid>
          <TextBlock Classes="muted" Text="No extra timers yet." IsVisible="{Binding !HasMoreTimers}" />
          <ItemsControl ItemsSource="{Binding MoreTimers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TimerItemViewModel">
                <StackPanel Spacing="6" Margin="0,0,0,12">
                  <Grid ColumnDefinitions="96,*,Auto,Auto">
                    <Border Classes="chip" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding KindLabel}"
                                 Foreground="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Clock}" FontSize="20" FontWeight="Bold" Margin="16,0"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                      <Button Classes="primary compact" Content="Start" Command="{Binding ToggleCommand}"
                              IsVisible="{Binding !IsRunning}" />
                      <Button Classes="primary compact" Content="Pause" Command="{Binding ToggleCommand}"
                              IsVisible="{Binding IsRunning}" />
                      <Button Classes="ghost compact" Content="Finish &amp; save" Command="{Binding FinishCommand}" />
                      <Button Classes="ghost compact" Content="Remove" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2"
                               Background="{DynamicResource TrackBrush}"
                               Foreground="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Alarms -->
      <Border Classes="card enter3">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="Alarms" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Rings at a time of day with the sound chosen in Settings. An alarm that passed while the app was closed stays silent." />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <TimePicker SelectedTime="{Binding NewAlarmTime}" MinuteIncrement="1" />
            <TextBox Grid.Column="1" Text="{Binding NewAlarmLabel}" Watermark="Label (optional)" MaxLength="80" />
            <CheckBox Grid.Column="2" Content="Every day" IsChecked="{Binding NewAlarmDaily}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="primary" Content="Add alarm" Command="{Binding AddAlarmCommand}" />
          </Grid>
          <TextBlock Classes="muted" Text="No alarms set." IsVisible="{Binding !HasAlarms}" />
          <ItemsControl ItemsSource="{Binding Alarms}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlarmItemViewModel">
                <Grid ColumnDefinitions="110,*,100,Auto,Auto" Margin="0,0,0,8">
                  <TextBlock Text="{Binding Time}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextBrush}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Repeat}" Classes="muted" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" Margin="0,0,10,0" />
                  <Button Grid.Column="4" Classes="ghost compact" Content="Remove" Command="{Binding RemoveCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- History -->
      <Border Classes="card enter3">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="Recent sessions" />
          <TextBlock Classes="muted" Text="Finished timers are listed here." IsVisible="{Binding !HasHistory}" />
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionViewModel">
                <Grid ColumnDefinitions="90,*,Auto,120" Margin="0,0,0,10">
                  <Border Classes="chip" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Kind}"
                               Foreground="{Binding Kind, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextBrush}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Duration}" FontWeight="SemiBold" Margin="16,0"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding When}" Classes="muted" VerticalAlignment="Center"
                             HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
