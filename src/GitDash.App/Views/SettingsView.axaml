<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitDash.Presentation.ViewModels"
             xmlns:set="using:GitDash.Application.Settings"
             xmlns:conv="using:GitDash.App.Converters"
             xmlns:c="using:GitDash.App.Controls"
             x:Class="GitDash.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="36,30,36,36" Spacing="22" MaxWidth="980" HorizontalAlignment="Left">

      <StackPanel Classes="enter" Spacing="4">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="muted" Text="Accounts, repositories, notifications and appearance." />
      </StackPanel>

      <!-- ===== Accounts ===== -->
      <Border Classes="card enter1">
        <StackPanel Spacing="16">
          <TextBlock Classes="h2" Text="GitHub accounts" />

          <TextBlock Classes="muted" Text="No account yet. Add one below." IsVisible="{Binding !Accounts.Count}" />
          <ItemsControl ItemsSource="{Binding Accounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountItemViewModel">
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Width="52" Height="52" Margin="0,0,14,0">
                      <Ellipse Fill="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold" Foreground="#0B0D14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Border CornerRadius="26" ClipToBounds="True">
                        <c:AvatarImage Url="{Binding AvatarUrl}" Stretch="UniformToFill" />
                      </Border>
                      <Ellipse Stroke="{StaticResource Accent2Brush}" StrokeThickness="2" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Text="{Binding Login}" Classes="muted" FontSize="12.5" />
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Border Classes="chip"><TextBlock Text="{Binding Method}" /></Border>
                        <Border Classes="chip"><TextBlock Text="{Binding RepositoriesLabel}" /></Border>
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" Content="Remove" Click="OnRemoveAccountClick"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Removes the account and deletes its stored token" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{DynamicResource LineBrush}" />

          <!-- Main way: the GitHub CLI login -->
          <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="16">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Sign in with GitHub CLI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" />
                <Border Classes="badge ok"><TextBlock Text="Recommended" /></Border>
                <Button Classes="round" Width="26" Height="26" VerticalAlignment="Center"
                    ToolTip.Tip="How to sign in with GitHub CLI">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="440" Spacing="10">
                    <TextBlock Text="How to sign in with GitHub CLI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="GitDash can reuse the login of the GitHub CLI (gh) that is already on your computer. No token to copy and no OAuth App." />
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="1." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Install GitHub CLI from cli.github.com (Windows: winget install GitHub.cli, macOS: brew install gh)." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="2." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="In a terminal, run: gh auth login. Choose GitHub.com and sign in with the browser." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="3." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Using an organization with SAML single sign-on? Run: gh auth refresh -s read:org, then authorize the organization when GitHub asks." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="4." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Click &quot;Sign in with GitHub CLI&quot; here. GitDash copies the token into its own secure store." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="5." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="If you log in again later, click the button again to refresh the copy." />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Reuses the login of the GitHub CLI (gh) on this computer: no token to copy and no app for your organization to approve. Run gh auth login once in a terminal, then click the button. GitDash reads the token with gh auth token." />
              <Button Classes="primary" Content="Sign in with GitHub CLI" Command="{Binding UseGitHubCliCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <!-- Advanced: token and OAuth App -->
          <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
            <Expander.Header>
              <TextBlock Text="Advanced sign-in options" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                         VerticalAlignment="Center" />
            </Expander.Header>
            <StackPanel Spacing="18">

              <!-- Personal access token -->
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Personal access token" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                             VerticalAlignment="Center" />
                  <Button Classes="round" Width="26" Height="26" VerticalAlignment="Center"
                    ToolTip.Tip="How to create a classic access token">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="440" Spacing="10">
                    <TextBlock Text="How to create a classic access token" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="A classic token belongs to you, so no organization has to approve an app. It works for private repositories and organizations unless the organization has blocked classic tokens." />
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="1." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="GitHub → your profile picture → Settings → Developer settings → Personal access tokens → Tokens (classic) → Generate new token (classic). The button below opens that page with the right scopes already ticked." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="2." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Note: GitDash. Expiration: your choice, for example 90 days." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="3." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Scopes: repo and read:org." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="4." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Click Generate token and copy it now. GitHub shows it only once." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="5." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Organization with SAML single sign-on: next to the token, click Configure SSO, then Authorize your organization." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="6." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Paste the token into the box below and click Add account." />
                    </Grid>
                    <Button Classes="primary" Content="Open GitHub: New classic token" Click="OnOpenNewTokenClick"
                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Create a classic token with the repo and read:org scopes. A fine-grained token with read-only Pull requests and Metadata also works. No app approval from your organization is needed." />
                <TextBox Text="{Binding TokenInput}" PasswordChar="●" Watermark="Paste token" MaxLength="255" />
                <Button Classes="primary" Content="Add account" Command="{Binding AddTokenCommand}" HorizontalAlignment="Left" />
              </StackPanel>

              <Border Height="1" Background="{DynamicResource LineBrush}" />

              <!-- OAuth App (browser sign-in) -->
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="OAuth App (sign in with your browser)" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                             VerticalAlignment="Center" />
                  <Button Classes="round" Width="26" Height="26" VerticalAlignment="Center"
                    ToolTip.Tip="How to create a GitHub OAuth App (needed for browser sign-in)">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="440" Spacing="10">
                    <TextBlock Text="How to create a GitHub OAuth App" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Browser sign-in uses GitHub's device flow, which needs the Client ID of an OAuth App that you register once. Prefer not to? Add a personal access token below instead." />
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="1." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Open GitHub, then Settings → Developer settings → OAuth Apps → New OAuth App. The button below opens that page." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="2." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Application name: anything, for example GitDash. Homepage URL: any valid link, for example https://github.com/krrish-soliton/GitDash." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="3." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Authorization callback URL: http://localhost (GitHub requires one, but the device flow never uses it)." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="4." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Tick &quot;Enable Device Flow&quot;, then click Register application." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="5." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Copy the Client ID shown on the app's page (it starts with Ov23li). You do not need a client secret." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="6." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Paste the Client ID into the box under &quot;Sign in with your browser&quot; and click Sign in with GitHub." />
                    </Grid>
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="7." FontWeight="Bold" Foreground="{StaticResource Accent2Brush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                 Text="Repositories of an organization that restricts OAuth apps need an owner to approve the app first (Organization settings → Third-party access)." />
                    </Grid>
                    <Button Classes="primary" Content="Open GitHub: New OAuth App" Click="OnOpenOAuthAppsClick"
                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Organizations that restrict OAuth apps need an owner to approve it; prefer the GitHub CLI or a token there." />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Uses GitHub's device flow. Needs the client ID of a GitHub OAuth App with device flow enabled — no client secret is involved." />
              <TextBox Text="{Binding ClientId}" Watermark="OAuth App client ID (e.g. Ov23li…)" MaxLength="64"
                       IsEnabled="{Binding !IsDeviceFlowPending}" />
              <Button Classes="primary" Content="Sign in with GitHub" Command="{Binding SignInCommand}"
                      HorizontalAlignment="Left" IsVisible="{Binding !IsDeviceFlowPending}" />

              <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="16"
                      IsVisible="{Binding IsDeviceFlowPending}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="label" Text="ENTER THIS CODE ON GITHUB" />
                  <SelectableTextBlock Text="{Binding UserCode}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource Accent2Brush}" LetterSpacing="3" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Open GitHub" Command="{Binding OpenVerificationCommand}" />
                    <Button Classes="ghost" Content="Cancel" Command="{Binding CancelSignInCommand}" />
                    <Ellipse Classes="pulse" Width="9" Height="9" Fill="{StaticResource Accent2Brush}"
                             VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
              </StackPanel>
            </StackPanel>
          </Expander>

          <TextBlock Text="{Binding AuthMessage}" Classes="muted" Classes.error="{Binding IsAuthError}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding AuthMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- ===== Repositories ===== -->
      <Border Classes="card enter2">
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
              <TextBlock Classes="h2" Text="Repositories to monitor" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="chip" Margin="0,0,12,0">
                <TextBlock Text="{Binding SelectionSummary}" />
              </Border>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="14">
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Lists your own repositories and those of the organizations you belong to. Only ticked repositories are synced." />

          <Grid ColumnDefinitions="220,12,*,12,Auto">
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                      HorizontalAlignment="Stretch" PlaceholderText="Account">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountItemViewModel">
                  <TextBlock Text="{Binding Login}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="2" Text="{Binding RepositoryFilter}" Watermark="Filter by owner or name" />
            <Button Grid.Column="4" Classes="ghost" Content="Reload" Command="{Binding ReloadRepositoriesCommand}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoadingRepositories}">
            <Ellipse Classes="pulse" Width="9" Height="9" Fill="{StaticResource Accent2Brush}" />
            <TextBlock Classes="muted" Text="Loading repositories…" />
          </StackPanel>
          <TextBlock Classes="error" Text="{Binding RepositoryMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding RepositoryMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- ListBox virtualises, so an account with a thousand repositories stays light. -->
          <ListBox ItemsSource="{Binding Repositories}" Height="300" Background="{DynamicResource Surface2Brush}"
                   CornerRadius="12">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RepositoryChoiceViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding FullName}" />
                  <Border Grid.Column="1" Classes="chip" Margin="8,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsPrivate}">
                    <TextBlock Text="Private" />
                  </Border>
                  <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </StackPanel>
        </Expander>
      </Border>

      <!-- ===== Notifications ===== -->
      <Border Classes="card enter3">
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header><TextBlock Classes="h2" Text="Notifications" VerticalAlignment="Center" /></Expander.Header>
          <StackPanel Spacing="12">
          <TextBlock Classes="muted" FontSize="12" Text="Notify me whenever…" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="A new pull request is assigned to me" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyAssigned}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="I am added as a reviewer" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyReviewRequested}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="New comments are posted on pull requests I am responsible for"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyComments}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="A pull request gets merged" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyMerged}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Removed as assignee" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Tell me when I am taken off a pull request." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyUnassigned}" OnContent="" OffContent="" />
          </Grid>

          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4" />

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Use operating system notifications" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Off: GitDash's own animated toasts. On: Windows notification centre / macOS Notification Center." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseNativeNotifications}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Also show the toast when the island is on" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Off: with the dynamic island switched on, notifications appear only on the island." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowToastWithIsland}" OnContent="" OffContent="" />
          </Grid>
          <TextBlock Text="Disappear by themselves (off = stays until you close it)" Classes="label" Margin="0,6,0,0" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Assigned to me" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="A pull request was assigned to you." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseAssigned}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Review requested" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="You were asked to review or re-approve." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseReview}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="New comments" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Someone commented on a PR you follow." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseComment}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Merged / closed" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="A pull request was merged or closed." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseMerged}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Removed as assignee" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Someone took you off a pull request." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseRemoved}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Timers and AI limits" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Pomodoro, review timers and AI usage resets." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseTimer}" OnContent="" OffContent="" />
          </Grid>
          <Button Classes="ghost" Content="Send a test notification" Command="{Binding TestNotificationCommand}" />
        </StackPanel>
        </Expander>
      </Border>

      <!-- ===== Sounds ===== -->
      <Border Classes="card enter3">
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header><TextBlock Classes="h2" Text="Sounds" VerticalAlignment="Center" /></Expander.Header>
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Play sounds" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Timers and alarms always ring when this is on. Off silences everything." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SoundEnabled}" OnContent="" OffContent="" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Also play a sound for notifications" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Assigned, review, comment, merged and removed notifications." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SoundOnNotifications}" OnContent="" OffContent="" />
            </Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4" />
            <TextBlock Text="Sound" Foreground="{DynamicResource TextBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <!-- The drop-down is the pop-up list of sounds; picking one plays it -->
              <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedSound}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="set:SoundOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Classes="ghost" Content="Play" Command="{Binding PreviewSoundCommand}" />
            </Grid>
            <TextBlock Text="Your own tone" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Load a short wav, mp3, aiff or m4a file. It is used in place of the built-in sound; the file stays where it is." />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding CustomSoundName}" Classes="muted" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Classes="ghost" Content="Load tone…" Click="OnLoadToneClick" />
              <Button Grid.Column="2" Classes="ghost" Content="Remove" Command="{Binding ClearCustomSoundCommand}"
                      IsVisible="{Binding HasCustomSound}" />
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <!-- ===== General ===== -->
      <Border Classes="card enter3">
        <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header><TextBlock Classes="h2" Text="Appearance" VerticalAlignment="Center" /></Expander.Header>
          <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Theme" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" Text="Dark, light, or follow the operating system." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <RadioButton GroupName="theme" Content="Dark" IsChecked="{Binding IsDark}" />
              <RadioButton GroupName="theme" Content="Light" IsChecked="{Binding IsLight}" />
              <RadioButton GroupName="theme" Content="System" IsChecked="{Binding FollowsSystemTheme}" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Glass effect" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="A glowing glass finish with a slow sheen on the dynamic island (compact and expanded) and on the widgets." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GlassEffect}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Date and time" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="GitHub reports times in UTC. They are converted to your local time and shown in your system's regional format, or in a format you pick." />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding TimeFormatOptions}" SelectedIndex="{Binding TimeFormatIndex}"
                      Width="210" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Reduce motion" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" Text="Turns off looping and entrance animations." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}" OnContent="" OffContent="" />
          </Grid>
        
          </StackPanel>
        </Expander>
      </Border>
      <Border Classes="card enter3">
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header><TextBlock Classes="h2" Text="Widgets and island" VerticalAlignment="Center" /></Expander.Header>
          <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Floating PR widget" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Semi-transparent, always on top, and click-through: it lights up under the mouse but never steals a click. Also shows how long your oldest assigned PR has waited." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowFloatingWidget}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Mini widget" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="On: the widget is a small circle that expands when you hover over it. Off: it always stays as the full card." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MiniWidget}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Floating timer widget" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="A small clock for your running Pomodoro, PR-review or task timer." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTimerWidget}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Show several timers at once" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="When Pomodoro, task and review timers run together, list each one on the timer widget and the island. Off shows only the most relevant one." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowMultipleTimers}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Dynamic island" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="A pill at the top of the screen showing your counts and timer. It grows to show notifications and, on hover, your oldest waiting PR." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowDynamicIsland}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Click through the widgets and island" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Mouse clicks pass through them to the window underneath; they still react to hovering. A notification that does not close by itself stays clickable so you can dismiss it." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClickThroughOverlays}" OnContent="" OffContent="" />
          </Grid>
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Widget opacity" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Classes="muted"><Run Text="{Binding WidgetOpacityPercent}" /><Run Text="%" /></TextBlock>
            </Grid>
            <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WidgetOpacityPercent}" />
            <TextBlock Classes="muted" FontSize="12" Text="How see-through the widgets are until you hover over them." />
          </StackPanel>
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Dynamic island opacity" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Classes="muted"><Run Text="{Binding IslandOpacityPercent}" /><Run Text="%" /></TextBlock>
            </Grid>
            <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding IslandOpacityPercent}" />
            <TextBlock Classes="muted" FontSize="12" Text="How see-through the island is until you hover over it." />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Move the floating widgets and the island" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Switch on to unlock them: they turn solid and can be dragged. Switch off to lock them in place and make them click-through again." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding WidgetUnlocked}" OnContent="Unlocked" OffContent="Locked" />
          </Grid>
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Widget position: horizontal" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Classes="muted"><Run Text="{Binding WidgetXPercent}" /><Run Text="%" /></TextBlock>
            </Grid>
            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WidgetXPercent}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Widget position: vertical" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Classes="muted"><Run Text="{Binding WidgetYPercent}" /><Run Text="%" /></TextBlock>
            </Grid>
            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WidgetYPercent}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Where the full widget sits on the screen: 0 % is the left / top edge, 100 % the right / bottom edge. It always stays fully on screen." />
          </StackPanel>
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Mini widget position inside the widget: horizontal" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Classes="muted"><Run Text="{Binding MiniXPercent}" /><Run Text="%" /></TextBlock>
            </Grid>
            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MiniXPercent}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Mini widget position inside the widget: vertical" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Classes="muted"><Run Text="{Binding MiniYPercent}" /><Run Text="%" /></TextBlock>
            </Grid>
            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MiniYPercent}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Where the small circle sits within the full widget's area. On hover the widget grows from the circle to its full size." />
          </StackPanel>
          </StackPanel>
        </Expander>
      </Border>
      <Border Classes="card enter3">
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header><TextBlock Classes="h2" Text="Window and tray" VerticalAlignment="Center" /></Expander.Header>
          <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Live check (seconds)" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="How often each repository is asked for changes (5 – 300). An unchanged repository costs no API quota; data is only downloaded when something really changed." />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Value="{Binding LiveCheckSeconds}" Minimum="5" Maximum="300"
                           Increment="5" FormatString="0" Width="150" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Tray / menu bar counter" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Native icon in the Windows notification area or the macOS menu bar. Closing the window keeps the app running there." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTrayIcon}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Hide to tray on minimise" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Minimising sends the window to the tray instead of the taskbar. Needs the tray icon." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideToTrayOnMinimize}" IsEnabled="{Binding ShowTrayIcon}"
                          OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Hide to tray on close" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Closing the window keeps GitDash running in the tray. Off: closing quits the app. Needs the tray icon." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideToTrayOnClose}" IsEnabled="{Binding ShowTrayIcon}"
                          OnContent="" OffContent="" />
          </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <!-- ===== AI tools ===== -->
      <ContentControl Content="{Binding AiTools}">
       <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:AiToolsViewModel">
      <Border Classes="card enter3">
        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
          <Expander.Header><TextBlock Classes="h2" Text="AI tool limits" VerticalAlignment="Center" /></Expander.Header>
          <StackPanel Spacing="12">
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Track Claude, ChatGPT or any other AI tool. No vendor offers a way to read subscription usage, so press “Limit reached” when you hit the cap: GitDash counts down to the reset and rings an alarm with a notification when the tool is usable again." />

          <TextBlock Classes="muted" Text="No tools added yet." IsVisible="{Binding !HasTools}" />
          <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AiToolItemViewModel">
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Width="46" Height="46" Margin="0,0,14,0">
                      <Ellipse Fill="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold" Foreground="#0B0D14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <ProgressBar Classes="thin" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                   IsVisible="{Binding !IsAvailable}" Margin="4,0" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource GreenBrush}"
                                 IsVisible="{Binding IsAvailable}" />
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource RedBrush}"
                                 IsVisible="{Binding !IsAvailable}" />
                        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12.5" />
                        <TextBlock Text="{Binding Remaining}" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{StaticResource AmberBrush}" IsVisible="{Binding !IsAvailable}" />
                      </StackPanel>
                      <TextBlock Text="{Binding WindowLabel}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="ghost" Content="Limit reached" Click="OnLimitReachedClick" IsVisible="{Binding IsAvailable}" />
                      <Button Classes="ghost" Content="Available now" Click="OnClearLimitClick" IsVisible="{Binding !IsAvailable}" />
                      <Button Classes="ghost" Content="Remove" Click="OnRemoveToolClick" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <TextBlock Text="Add a tool" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <ItemsControl ItemsSource="{Binding PresetNames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="ghost" Content="{Binding}" Margin="0,0,6,6" Click="OnPresetClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,12,200,12,Auto">
            <TextBox Text="{Binding NewName}" Watermark="Tool name" MaxLength="40" />
            <NumericUpDown Grid.Column="2" Value="{Binding NewWindowMinutes}" Minimum="1" Maximum="44640" Increment="30"
                           FormatString="0 &quot;min&quot;" />
            <Button Grid.Column="4" Classes="primary" Content="Add tool" Command="{Binding AddCommand}" />
          </Grid>
          <TextBlock Classes="muted" FontSize="11.5"
                     Text="The window is how long a limit lasts after you hit it: 300 min ≈ Claude's 5-hour window, 1440 min = daily, 43200 min = monthly." />
        </StackPanel>
        </Expander>
      </Border>
        </DataTemplate>
       </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- ===== Security ===== -->
      <Border Classes="card enter3">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="How your credentials are protected" />
          <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                     Text="Tokens are stored only in the operating system's protected storage — Windows Data Protection (DPAPI) bound to your Windows user, or the macOS Keychain — never in the settings file. They are sent only to github.com over HTTPS, GitHub is accessed read-only, and removing an account deletes its token immediately." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
