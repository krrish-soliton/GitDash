<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitDash.Presentation.ViewModels"
             xmlns:c="using:GitDash.App.Controls"
             xmlns:conv="using:GitDash.App.Converters"
             x:Class="GitDash.App.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">
  <!-- One centred column: header, filters, then the notifications grouped by day -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="860" HorizontalAlignment="Center" Margin="36,30,36,40" Spacing="14">
      <StackPanel Classes="enter" Spacing="4">
        <TextBlock Classes="h1" Text="Notifications" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding Summary}" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <ToggleButton Classes="filter" Content="Unread only" IsChecked="{Binding OnlyUnread}" />
        <Button Classes="ghost compact" Content="Mark all read" Command="{Binding MarkAllReadCommand}" />
        <Button Classes="ghost compact" Content="Clear history" Command="{Binding ClearCommand}" />
      </StackPanel>
      <TextBlock Classes="muted" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" />

      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationDayViewModel">
            <StackPanel Spacing="10" Margin="0,6,0,0">
              <Grid ColumnDefinitions="Auto,*">
                <Border Background="{DynamicResource ChipBrush}" CornerRadius="999" Padding="12,4">
                  <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="Bold" Foreground="White" />
                </Border>
                <Border Grid.Column="1" Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Center"
                        Margin="10,0,0,0" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NotificationItemViewModel">
                    <Border Classes="card" Margin="0,0,0,12" Padding="18,16">
                      <Grid ColumnDefinitions="Auto,*">
                        <!-- Colour tile, with the person's picture on its corner -->
                        <Panel Width="50" Height="48" VerticalAlignment="Top">
                          <Border Width="42" Height="42" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}">
                            <PathIcon Data="{StaticResource IconPullRequest}" Width="19" Height="19" Foreground="#0B0D14" />
                          </Border>
                          <Border IsVisible="{Binding HasActor}" Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="2"
                                  BorderBrush="{DynamicResource SurfaceBrush}" Background="{DynamicResource Surface2Brush}">
                            <c:AvatarImage Url="{Binding AvatarUrl}" Stretch="UniformToFill" />
                          </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                       IsVisible="{Binding IsUnread}" ToolTip.Tip="Unread" />
                              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" HorizontalAlignment="Right">
                              <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                                      Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}">
                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#0B0D14" />
                              </Border>
                              <TextBlock Text="{Binding Stamp}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13.5"
                                     Foreground="{DynamicResource TextBrush}" />

                          <!-- The details as a small table: label on the left, value on the right -->
                          <Border IsVisible="{Binding HasDetail}" Background="{DynamicResource Surface2Brush}" CornerRadius="10"
                                  Padding="14,10">
                            <ItemsControl ItemsSource="{Binding DetailRows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NotificationDetailRow">
                                  <Grid ColumnDefinitions="150,*" Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Classes="muted" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap"
                                                         Foreground="{DynamicResource TextBrush}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>

                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <c:UserChip Login="{Binding ActorName}" IsVisible="{Binding HasActor}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding WhenText}" Classes="muted" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                              <Button Classes="ghost compact" Content="Mark as read" Command="{Binding MarkReadCommand}"
                                      IsVisible="{Binding IsUnread}" />
                              <Button Classes="ghost compact" Content="{Binding ActionText}" Command="{Binding OpenCommand}" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
