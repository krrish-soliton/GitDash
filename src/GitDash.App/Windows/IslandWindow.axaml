<w:FloatingWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDash.Presentation.ViewModels"
        xmlns:w="using:GitDash.App.Windows"
        x:Class="GitDash.App.Windows.IslandWindow"
        x:DataType="vm:ShellViewModel"
        Width="240" Height="48"
        Title="GitDash island">

  <Window.Styles>
    <!-- The pill itself animates between sizes; the window follows (see code-behind). -->
    <Style Selector="Border#Pill">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut" />
          <DoubleTransition Property="Height" Duration="0:0:0.32" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.unlocked Border#Pill">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Window.motion Ellipse.live">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border#Life.run">
      <Style.Animations>
        <Animation Duration="0:0:6" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Border x:Name="Pill" Width="230" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          CornerRadius="22" Background="#F00B0D14" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True"
          BoxShadow="0 8 24 0 #66000000"
          PointerPressed="OnPressed" Cursor="Hand">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Compact row: always visible -->
      <Grid Height="34" ColumnDefinitions="Auto,*,Auto" Margin="14,0">
        <Ellipse x:Name="StatusDot" Classes="live" Width="9" Height="9" Fill="{StaticResource Accent2Brush}"
                 VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Accent2Brush}">
            <Run Text="{Binding Widget.Assigned}" /><Run Text=" assigned" FontWeight="Normal" Foreground="#A0A8C0" />
          </TextBlock>
          <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AmberBrush}">
            <Run Text="{Binding Widget.Approval}" /><Run Text=" to approve" FontWeight="Normal" Foreground="#A0A8C0" />
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Timers.WidgetClock}" FontSize="12.5" FontWeight="Bold"
                   Foreground="White" VerticalAlignment="Center" IsVisible="{Binding Timers.IsAnyRunning}" />
      </Grid>

      <!-- Expanded content: a notification, or details while hovering -->
      <Grid Grid.Row="1" x:Name="Detail" ColumnDefinitions="Auto,*,Auto" Margin="16,2,12,6" IsVisible="False">
        <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="11" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconPullRequest}" Width="16" Height="16" Foreground="#0B0D14" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="MessageText" FontSize="12" Foreground="#A0A8C0" TextWrapping="Wrap" MaxLines="2"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="2" Classes="round" Width="24" Height="24" VerticalAlignment="Top"
                Click="OnCloseClick" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" />
        </Button>
      </Grid>

      <Border x:Name="Life" Grid.Row="2" Height="3" RenderTransformOrigin="0%,50%" IsVisible="False">
        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
      </Border>
    </Grid>
  </Border>
</w:FloatingWindow>
