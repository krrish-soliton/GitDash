<w:FloatingWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDash.Presentation.ViewModels"
        xmlns:w="using:GitDash.App.Windows"
        xmlns:conv="using:GitDash.App.Converters"
        xmlns:c="using:GitDash.App.Controls"
        x:Class="GitDash.App.Windows.IslandWindow"
        x:DataType="vm:ShellViewModel"
        Width="240" Height="48"
        Title="GitDash island">

  <Window.Styles>
    <!-- The pill itself animates between sizes; the window follows (see code-behind). -->
    <Style Selector="Border#Pill">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut" />
          <DoubleTransition Property="Height" Duration="0:0:0.32" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Counters fade out and back in as the island rotates to the next pair -->
    <Style Selector="ItemsControl#StatusRow">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.unlocked Border#Pill">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Window.motion Ellipse.live">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Border x:Name="Pill" Width="230" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          CornerRadius="22" Background="#F00B0D14" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True"
          BoxShadow="0 8 24 0 #66000000"
          PointerPressed="OnPressed" Cursor="Hand">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Compact row plus one line per running timer: always visible -->
      <StackPanel>
        <Grid MinHeight="34" ColumnDefinitions="Auto,*" Margin="14,0">
          <Ellipse x:Name="StatusDot" Classes="live" Width="9" Height="9" Fill="{StaticResource Accent2Brush}"
                   VerticalAlignment="Center" />
          <!-- The configured counters: two at a time (rotating) while compact, all of them while expanded -->
          <ItemsControl x:Name="StatusRow" Grid.Column="1" ItemsSource="{Binding Widget.IslandRow}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatusItemViewModel">
                <TextBlock FontSize="12.5" FontWeight="Bold" Margin="6,2"
                           Foreground="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}">
                  <Run Text="{Binding Count}" /><Run Text=" " /><Run Text="{Binding Label}" FontWeight="Normal" Foreground="#A0A8C0" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <ItemsControl ItemsSource="{Binding Timers.VisibleTimers}" Margin="16,0,16,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RunningTimerViewModel">
              <Grid Height="38" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Top">
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#A0A8C0" TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Clock}" FontSize="12" FontWeight="Bold" Foreground="White" />
                <!-- Stays clickable even when the island lets the mouse pass through (class "hit") -->
                <Button Grid.Column="2" Classes="round hit" Width="18" Height="18" MinHeight="18" Padding="0" Margin="8,0,0,0"
                        Command="{Binding StopCommand}" ToolTip.Tip="Stop (pause) this timer">
                  <PathIcon Data="M0,0 H8 V8 H0 Z" Width="7" Height="7" />
                </Button>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Height="4" MinHeight="4" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Top"
                             Foreground="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Expanded content: a notification, or details while hovering -->
      <Grid Grid.Row="1" x:Name="Detail" ColumnDefinitions="Auto,*" Margin="16,2,12,6" IsVisible="False">
        <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="11" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconPullRequest}" Width="16" Height="16" Foreground="#0B0D14" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="MessageText" FontSize="12" Foreground="#A0A8C0" TextWrapping="Wrap" MaxLines="2"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <!-- Stacked notifications: newest on top -->
      <ItemsControl x:Name="Notes" Grid.Row="1" Margin="12,2,12,6" IsVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="w:IslandNote">
            <Grid Height="52" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
              <Panel Width="38" Height="34" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="10" Background="{Binding Accent}" HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                  <PathIcon Data="{StaticResource IconPullRequest}" Width="14" Height="14" Foreground="#0B0D14" />
                </Border>
                <!-- The person involved, on the corner of the icon -->
                <Border IsVisible="{Binding HasAvatar}" Width="19" Height="19" CornerRadius="10" ClipToBounds="True"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="1.5" BorderBrush="#F00B0D14"
                        Background="#2A3050">
                  <c:AvatarImage Url="{Binding AvatarUrl}" Stretch="UniformToFill" />
                </Border>
              </Panel>
              <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="#A0A8C0" MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <!-- Class "hit": clickable even while the island lets the mouse pass through -->
              <Button Grid.Column="2" Classes="round hit" Width="22" Height="22" MinHeight="22" Padding="0"
                      VerticalAlignment="Center" Click="OnNoteCloseClick" ToolTip.Tip="Dismiss">
                <PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" />
              </Button>
              <!-- Shrinks while the row waits to close by itself -->
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" Value="{Binding Remaining}"
                           IsVisible="{Binding HasTimer}" Height="3" MinHeight="3" CornerRadius="2"
                           Margin="2,0,2,0" Background="#33FFFFFF" Foreground="{Binding Accent}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <c:GlassGlaze Grid.RowSpan="3" CornerRadius="22" />

    </Grid>
  </Border>
</w:FloatingWindow>
