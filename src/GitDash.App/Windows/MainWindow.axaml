<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDash.Presentation.ViewModels"
        xmlns:views="using:GitDash.App.Views"
        xmlns:conv="using:GitDash.App.Converters"
        xmlns:c="using:GitDash.App.Controls"
        x:Class="GitDash.App.Windows.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="GitDash"
        Icon="/Assets/app.ico"
        Width="1280" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <Window.Styles>
    <Style Selector="Border.noteRow.unread">
      <Setter Property="Background" Value="#1A818CF8" />
    </Style>
    <!-- Custom caption buttons: background fades in, the glyph pops; close turns red and spins. -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E5484D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.caption PathIcon">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.caption:pointerover PathIcon">
      <Setter Property="RenderTransform" Value="scale(1.22)" />
    </Style>
    <Style Selector="Button.caption.close:pointerover PathIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg) scale(1.1)" />
    </Style>

    <!-- Light / dark / system switch in the title bar -->
    <Style Selector="RadioButton.themeOpt">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.themeOpt /template/ Border#Bg">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.themeOpt:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="RadioButton.themeOpt:checked">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource Accent2Brush}" />
    </Style>

    <!-- Collapsible sidebar: widths animate; labels fade; the collapsed state shows only icons -->
    <Style Selector="Panel#SidebarHost, Border#Sidebar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Sidebar :is(Control).hc">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Sidebar.collapsed :is(Control).hc">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border#Sidebar :is(Control).sc">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#Sidebar.collapsed :is(Control).sc">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border#Sidebar.collapsed :is(Control).hv">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#Sidebar.floating">
      <Setter Property="BoxShadow" Value="0 0 34 0 #80000000" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="vm:PeopleViewModel">
      <views:PeopleView />
    </DataTemplate>
    <DataTemplate DataType="vm:MyPullRequestsViewModel">
      <views:MyPullRequestsView />
    </DataTemplate>
    <DataTemplate DataType="vm:TimersViewModel">
      <views:TimersView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Rounded window frame: the window itself is transparent, this border draws the rounded shape. -->
  <Border x:Name="Frame" Background="{DynamicResource BgBrush}" CornerRadius="14" ClipToBounds="True"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Panel>
    <DockPanel>
      <!-- Custom title bar: drag to move, double-click to maximise -->
      <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="Transparent"
              PointerPressed="OnTitlePressed" DoubleTapped="OnTitleDoubleTapped">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource AccentGradient}">
              <PathIcon Data="{StaticResource IconPullRequest}" Width="11" Height="11" Foreground="White" />
            </Border>
            <TextBlock Text="GitDash" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <!-- Notification history: the bell with the number of unread notifications -->
            <Button Classes="round" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"
                    Command="{Binding NotificationCenter.ToggleCommand}" ToolTip.Tip="Notifications">
              <Panel>
                <PathIcon Data="{StaticResource IconBell}" Width="15" Height="15" />
                <Border IsVisible="{Binding NotificationCenter.HasUnread}" MinWidth="15" Height="15" CornerRadius="8"
                        Padding="3,0" Background="#FB7185" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-9,-10,0" IsHitTestVisible="False">
                  <TextBlock Text="{Binding NotificationCenter.BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </Button>
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="2" Margin="0,0,10,0"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="themeOpt" IsChecked="{Binding Settings.IsLight}" ToolTip.Tip="Light">
                  <PathIcon Data="{StaticResource IconSun}" Width="14" Height="14" />
                </RadioButton>
                <RadioButton Classes="themeOpt" IsChecked="{Binding Settings.IsDark}" ToolTip.Tip="Dark">
                  <PathIcon Data="{StaticResource IconMoon}" Width="14" Height="14" />
                </RadioButton>
                <RadioButton Classes="themeOpt" IsChecked="{Binding Settings.FollowsSystemTheme}" ToolTip.Tip="Follow the system">
                  <PathIcon Data="{StaticResource IconSystem}" Width="14" Height="14" />
                </RadioButton>
              </StackPanel>
            </Border>
            <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="Minimise">
              <PathIcon Data="M0,4.5 H10 V5.5 H0 Z" Width="10" Height="10" />
            </Button>
            <Button Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="Maximise / restore">
              <Panel>
                <PathIcon x:Name="MaxIcon" Data="M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z" Width="10" Height="10" />
                <PathIcon x:Name="RestoreIcon" IsVisible="False"
                          Data="M2,0 H10 V8 H8 V7 H9 V1 H3 V2 H2 Z M0,2 H8 V10 H0 Z M1,3 V9 H7 V3 Z" Width="10" Height="10" />
              </Panel>
            </Button>
            <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="Close">
              <PathIcon Data="M1,0 L5,4 L9,0 L10,1 L6,5 L10,9 L9,10 L5,6 L1,10 L0,9 L4,5 L0,1 Z" Width="10" Height="10" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

  <Grid ColumnDefinitions="Auto,*">

    <!-- Sidebar -->
    <Panel x:Name="SidebarHost" Grid.Column="0" Width="232" ZIndex="10">
    <Border x:Name="Sidebar" Width="232" HorizontalAlignment="Left" ClipToBounds="True"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,22,16,16"
            PointerEntered="OnSidebarEntered" PointerExited="OnSidebarExited">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="4,0,0,26">
          <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentGradient}">
            <PathIcon Data="{StaticResource IconPullRequest}" Width="18" Height="18" Foreground="White" />
          </Border>
          <StackPanel Classes="hc" VerticalAlignment="Center">
            <TextBlock Text="GitDash" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Pull request radar" Classes="muted" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <!-- Sync status, refresh and the pin button -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <StackPanel Classes="hc">
            <Border IsVisible="{Binding HasError}" Background="{DynamicResource ErrorBoxBrush}" CornerRadius="10" Padding="10"
                    ToolTip.Tip="{Binding Error}">
              <TextBlock Text="{Binding Error}" Classes="error" FontSize="11" TextWrapping="Wrap" MaxLines="4"
                         TextTrimming="CharacterEllipsis" />
            </Border>
          </StackPanel>
          <Grid Classes="hv" ColumnDefinitions="Auto,*,Auto">
            <Panel Width="10" Height="10" VerticalAlignment="Center" Margin="6,0,10,0">
              <Ellipse Fill="{StaticResource GreenBrush}" IsVisible="{Binding !IsSyncing}" />
              <Ellipse Classes="pulse" Fill="{StaticResource Accent2Brush}" IsVisible="{Binding IsSyncing}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Classes="round" Width="32" Height="32" Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Sync now">
              <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
            </Button>
          </Grid>
          <!-- Collapsed: only the refresh icon, lined up with the nav icons -->
          <Button Classes="round sc" Width="32" Height="32" Margin="6,0,0,0" HorizontalAlignment="Left"
                  Command="{Binding RefreshCommand}" ToolTip.Tip="Sync now">
            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
          </Button>
          <Button Classes="round" Width="32" Height="32" Margin="6,0,0,0" HorizontalAlignment="Left"
                  Click="OnPinClick" ToolTip.Tip="Collapse or pin the sidebar">
            <Panel>
              <PathIcon x:Name="CollapseIcon" Data="{StaticResource IconLeft}" Width="14" Height="14" />
              <PathIcon x:Name="PinIcon" Data="{StaticResource IconRight}" Width="14" Height="14" IsVisible="False" />
            </Panel>
          </Button>

          <!-- Version number, and what the updater is doing -->
          <StackPanel Classes="hc" Spacing="1" Margin="6,2,0,0" IsVisible="{Binding Updates.HasVersion}">
            <TextBlock Text="{Binding Updates.VersionText}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" ToolTip.Tip="The version of GitDash you are running" />
            <TextBlock Classes="muted" FontSize="10.5" Text="{Binding Updates.SidebarText}"
                       IsVisible="{Binding Updates.HasSidebarText}" />
            <Button Classes="ghost compact" Content="Update now" Command="{Binding Updates.PrimaryActionCommand}"
                    IsVisible="{Binding Updates.SidebarIsAction}" HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
          <TextBlock Classes="muted sc" FontSize="10" Text="{Binding Updates.VersionText}" Margin="2,0,0,0"
                     IsVisible="{Binding Updates.HasVersion}" ToolTip.Tip="{Binding Updates.SidebarText}" />
        </StackPanel>

        <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Width="17" Height="17"
                          Data="{Binding Icon, Converter={x:Static conv:GeometryKeyConverter.Instance}}" />
                <TextBlock Classes="hc" Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    </Panel>

    <!-- Pages -->
    <DockPanel Grid.Column="1">
      <!-- Shown while an update downloads and during the short countdown before the restart -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding Updates.ShowBanner}" Margin="36,14,36,0" Padding="16,12"
              CornerRadius="14" Background="{DynamicResource Surface2Brush}" BorderThickness="1"
              BorderBrush="{StaticResource Accent2Brush}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Text="{Binding Updates.BannerTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Grid.Row="1" Text="{Binding Updates.BannerDetail}" Classes="muted" FontSize="12" Margin="0,2,0,8" />
          <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Updates.ProgressValue}"
                       IsIndeterminate="{Binding Updates.IsIndeterminate}" Height="5" MinHeight="5" CornerRadius="3"
                       Background="{DynamicResource TrackBrush}" Foreground="{StaticResource Accent2Brush}" />
          <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                      VerticalAlignment="Center" IsVisible="{Binding Updates.IsReady}">
            <Button Classes="ghost compact" Content="Later" Command="{Binding Updates.LaterCommand}" />
            <Button Classes="primary compact" Content="Restart now" Command="{Binding Updates.RestartNowCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Repository filter shared by the list pages -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding ShowRepositoryFilter}" Padding="36,14,36,0">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <TextBlock Text="Repository" Classes="label" VerticalAlignment="Center" />
          <Button Classes="ghost" MinWidth="240" HorizontalContentAlignment="Stretch" ToolTip.Tip="Choose one or more repositories">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding RepositorySummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="▾" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer MaxHeight="360" MinWidth="260">
                  <ItemsControl ItemsSource="{Binding RepositoryOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RepositoryOptionViewModel">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="4,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Border>
      <TransitioningContentControl Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.16" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </DockPanel>
  </Grid>
    </DockPanel>

    <!-- Notification history panel, under the bell -->
    <Border IsVisible="{Binding NotificationCenter.IsOpen}" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,46,14,0" Width="420" MaxHeight="580" CornerRadius="16" ZIndex="50" ClipToBounds="True"
            Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            BoxShadow="0 12 32 0 #66000000">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,10,8">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Notifications" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Classes="muted" FontSize="11.5" Text="{Binding NotificationCenter.Summary}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost compact" Content="Mark all read" Margin="0,0,6,0"
                  Command="{Binding NotificationCenter.MarkAllReadCommand}" />
          <Button Grid.Column="2" Classes="ghost compact" Content="Clear" Margin="0,0,6,0"
                  Command="{Binding NotificationCenter.ClearCommand}" />
          <Button Grid.Column="3" Classes="round" Width="26" Height="26" Command="{Binding NotificationCenter.CloseCommand}"
                  ToolTip.Tip="Close">
            <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
          </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="Nothing yet. New pull request activity shows up here."
                   Margin="16,6,16,20" TextWrapping="Wrap" IsVisible="{Binding NotificationCenter.IsEmpty}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NotificationCenter.Items}" Margin="8,0,8,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NotificationItemViewModel">
                <Border Classes="noteRow" Classes.unread="{Binding IsUnread}" CornerRadius="12" Margin="0,2" Padding="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Classes="ghost" HorizontalContentAlignment="Stretch" Padding="8,8" Command="{Binding OpenCommand}">
                      <Grid ColumnDefinitions="Auto,*">
                        <!-- Colour tile with the person's picture on its corner -->
                        <Panel Width="44" Height="42" VerticalAlignment="Top">
                          <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}">
                            <PathIcon Data="{StaticResource IconPullRequest}" Width="16" Height="16" Foreground="#0B0D14" />
                          </Border>
                          <Border IsVisible="{Binding HasAvatar}" Width="22" Height="22" CornerRadius="11" ClipToBounds="True"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="2"
                                  BorderBrush="{DynamicResource PopupBrush}" Background="{DynamicResource Surface2Brush}">
                            <c:AvatarImage Url="{Binding AvatarUrl}" Stretch="UniformToFill" />
                          </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                          <TextBlock Text="{Binding Message}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding WhenText}" Classes="muted" FontSize="10.5" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="round" Width="24" Height="24" Margin="2,6,6,0" VerticalAlignment="Top"
                            IsVisible="{Binding IsUnread}" Command="{Binding MarkReadCommand}" ToolTip.Tip="Mark as read">
                      <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    </Panel>
  </Border>
</Window>
