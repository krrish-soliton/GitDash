<w:FloatingWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDash.Presentation.ViewModels"
        xmlns:c="using:GitDash.App.Controls"
        xmlns:w="using:GitDash.App.Windows"
        x:Class="GitDash.App.Windows.WidgetWindow"
        x:DataType="vm:WidgetViewModel"
        Width="92" Height="92"
        Title="GitDash widget">

  <Window.Styles>
    <Style Selector="Window.unlocked Border#Root">
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <!-- Collapsed: a small circle. Hovered (or unlocked): the full card, which grows out of the circle. -->
    <Style Selector="Panel#Card">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.25, 0.47)" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Window.hover Panel#Card">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1, 1)" />
    </Style>
    <Style Selector="Window.motion Panel#Card">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#Dot">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Window.hover Panel#Dot">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- Mini widget switched off: the full card is always shown (declared last so it wins over the rules above). -->
    <Style Selector="Window.full Panel#Card">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1, 1)" />
    </Style>
    <Style Selector="Window.full Panel#Dot">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Window.motion Panel#Dot">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion Border#Bubble">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border#MoveHint">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.unlocked Border#MoveHint">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Flashy loops (only while the window is allowed to animate) -->
    <Style Selector="Window.motion Rectangle.sheen">
      <Style.Animations>
        <Animation Duration="0:0:3.4" Delay="0:0:1" IterationCount="INFINITE" Easing="CubicEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-140" /></KeyFrame>
          <KeyFrame Cue="55%"><Setter Property="TranslateTransform.X" Value="380" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="380" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border.glow">
      <Style.Animations>
        <Animation Duration="0:0:1.7" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.95" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Ellipse.live">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion TextBlock.tick">
      <Style.Animations>
        <Animation Duration="0:0:2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.7" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Border x:Name="Root" Margin="6" ClipToBounds="False" DoubleTapped="OnDoubleTapped">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open GitDash" Click="OnOpenClick" />
        <MenuItem Header="Hide widget" Click="OnHideClick" />
      </ContextMenu>
    </Border.ContextMenu>

    <Panel>
      <!-- ===== Collapsed: circle with the assigned count and a notification bubble ===== -->
      <Panel x:Name="Dot" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border Width="78" Height="78" CornerRadius="39" Background="{DynamicResource WidgetBrush}" BorderThickness="2"
                BorderBrush="{StaticResource Accent2Brush}">
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <c:CountUpText Value="{Binding Assigned}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource Accent2Brush}" />
            <TextBlock Text="ASSIGNED" Classes="label" FontSize="8" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="Bubble" IsVisible="{Binding HasUnseen}" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                Background="{StaticResource RedBrush}" BorderBrush="White" BorderThickness="2"
                RenderTransformOrigin="50%,50%">
          <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
          <TextBlock Text="{Binding Unseen}" FontSize="11" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Panel>

      <!-- ===== Expanded: the counters and the oldest assigned wait ===== -->
      <Panel x:Name="Card" RenderTransformOrigin="100%,50%">
        <Border CornerRadius="20" Background="{DynamicResource WidgetBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource LineBrush}" ClipToBounds="True" BoxShadow="0 6 28 0 #55000000">
          <Panel>
            <Border Classes="glow" Height="3" VerticalAlignment="Top" Background="{StaticResource AccentGradient}" />
            <Rectangle Classes="sheen" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False">
              <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,40%">
                  <GradientStop Color="#00FFFFFF" Offset="0" />
                  <GradientStop Color="#33FFFFFF" Offset="0.5" />
                  <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>

            <Grid RowDefinitions="*,Auto,Auto" Margin="8,10,8,8">
              <Grid ColumnDefinitions="*,1,*,1,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                  <c:CountUpText Value="{Binding Assigned}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                 Foreground="{StaticResource Accent2Brush}" />
                  <TextBlock Text="ASSIGNED" Classes="label" FontSize="9.5" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,16" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                  <c:CountUpText Value="{Binding Approval}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                 Foreground="{StaticResource AmberBrush}" />
                  <TextBlock Text="TO APPROVE" Classes="label" FontSize="9.5" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource LineBrush}" Margin="0,16" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                  <c:CountUpText Value="{Binding Total}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="TOTAL OPEN" Classes="label" FontSize="9.5" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>

              <!-- Longest waits: a PR assigned to me, and a PR waiting for my approval -->
              <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource Surface2Brush}" Padding="10,7" Margin="2,4,2,0">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Classes="live" Width="8" Height="8" Fill="{StaticResource Accent2Brush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="OLDEST ASSIGNED" Classes="label" FontSize="9" Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="tick" Text="{Binding OldestAge}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource Accent2Brush}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Classes="live" Width="8" Height="8" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="OLDEST REVIEW" Classes="label" FontSize="9" Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="tick" Text="{Binding OldestReviewAge}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AmberBrush}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- The latest notification, while there is one that was not looked at yet -->
              <Border Grid.Row="2" IsVisible="{Binding HasUnseen}" CornerRadius="12" Padding="10,6" Margin="2,4,2,0"
                      Background="{StaticResource RedBrush}">
                <TextBlock Text="{Binding LastNotification}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>
          </Panel>
        </Border>
      </Panel>

      <Border x:Name="MoveHint" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-6,0,0" CornerRadius="8"
              Padding="8,2" Background="{StaticResource AccentBrush}">
        <TextBlock Text="DRAG TO MOVE" FontSize="9" FontWeight="Bold" Foreground="White" />
      </Border>
    </Panel>
  </Border>
</w:FloatingWindow>
