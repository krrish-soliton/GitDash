<w:FloatingWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDash.Presentation.ViewModels"
        xmlns:w="using:GitDash.App.Windows"
        xmlns:conv="using:GitDash.App.Converters"
        x:Class="GitDash.App.Windows.TimerWidgetWindow"
        x:DataType="vm:TimersViewModel"
        Width="250" Height="104"
        Title="GitDash timer">

  <Window.Styles>
    <Style Selector="Border#Root">
      <Setter Property="Opacity" Value="0.58" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.hover Border#Root">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Window.unlocked Border#Root">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Window.motion Ellipse.live">
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border.glow">
      <Style.Animations>
        <Animation Duration="0:0:1.7" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.95" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Border x:Name="Root" Margin="6" CornerRadius="20" Background="{DynamicResource WidgetBrush}" BorderThickness="1"
          BorderBrush="{DynamicResource LineBrush}" ClipToBounds="True" BoxShadow="0 6 28 0 #55000000"
          DoubleTapped="OnDoubleTapped">
    <Panel>
      <Border Classes="glow" Height="3" VerticalAlignment="Top" Background="{StaticResource AccentGradient}" />
      <ItemsControl ItemsSource="{Binding VisibleTimers}" VerticalAlignment="Center" Margin="18,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RunningTimerViewModel">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Ellipse Classes="live" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                <TextBlock Text="{Binding Label}" Classes="label" FontSize="10" MaxWidth="160"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <!-- Stays clickable even when the widget lets the mouse pass through (class "hit") -->
                <Button Classes="round hit" Width="18" Height="18" MinHeight="18" Padding="0"
                        Command="{Binding StopCommand}" ToolTip.Tip="Stop (pause) this timer">
                  <PathIcon Data="M0,0 H8 V8 H0 Z" Width="7" Height="7" />
                </Button>
              </StackPanel>
              <TextBlock Text="{Binding Clock}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2"
                           Background="{DynamicResource TrackBrush}" Foreground="{Binding Accent, Converter={x:Static conv:HexBrushConverter.Instance}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>
  </Border>
</w:FloatingWindow>
