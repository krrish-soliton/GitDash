<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GitDash.App.Controls"
        x:Class="GitDash.App.Windows.ToastWindow"
        Width="390" Height="104"
        SystemDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Title="GitDash notification">

  <Window.Styles>
    <!-- Slide in from the right -->
    <Style Selector="Border#Card.anim">
      <Style.Animations>
        <Animation Duration="0:0:0.38" Easing="CubicEaseOut" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="90" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Slide back out -->
    <Style Selector="Border#Card.closing">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseIn" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="90" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The icon pops once -->
    <Style Selector="Border#IconBadge.anim">
      <Style.Animations>
        <Animation Duration="0:0:0.55" Delay="0:0:0.2" Easing="BackEaseOut" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="0.3" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.3" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Remaining time drains away -->
    <Style Selector="Border#Life.anim">
      <Style.Animations>
        <Animation Duration="0:0:6" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Border x:Name="Card" Margin="6" CornerRadius="16" Background="{DynamicResource PopupBrush}" BorderThickness="1"
          BorderBrush="{DynamicResource LineBrush}" ClipToBounds="True" Cursor="Hand"
          PointerPressed="OnCardPressed">
    <Grid RowDefinitions="*,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,12,10,10">
        <Panel Width="50" Height="46" VerticalAlignment="Center">
          <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <PathIcon Data="{StaticResource IconPullRequest}" Width="18" Height="18" Foreground="#0B0D14" />
          </Border>
          <!-- The person involved, on the corner of the icon (hidden when there is none) -->
          <Border x:Name="AvatarBadge" IsVisible="False" Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="2"
                  BorderBrush="{DynamicResource PopupBrush}" Background="{DynamicResource Surface2Brush}">
            <c:AvatarImage x:Name="AvatarPic" Stretch="UniformToFill" />
          </Border>
        </Panel>
        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="3">
          <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Classes="round" Width="26" Height="26" VerticalAlignment="Top"
                Click="OnCloseClick" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
        </Button>
      </Grid>
      <Border x:Name="Life" Grid.Row="1" Height="3" RenderTransformOrigin="0%,50%" />
    </Grid>
  </Border>
</Window>
